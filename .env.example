# --- Required ---------------------------------------------------------
# Get this from @BotFather on Telegram (create a bot, copy the token)
TELEGRAM_BOT_TOKEN=

# Your chat id (message @userinfobot on Telegram to get it), or a group/channel id
TELEGRAM_CHAT_ID=

# --- Strongly recommended --------------------------------------------
# Free Helius key: https://dashboard.helius.dev  ->  use the RPC URL they give you
# e.g. https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# The default public RPC below WILL rate-limit you at pump.fun volume.
RPC_URL=https://api.mainnet-beta.solana.com

# --- Freshness tuning -------------------------------------------------
# Max transactions the creator may have BEFORE the launch to count as fresh.
# Brand-new wallets usually have 1-3 (funding transfer, account setup).
FRESH_MAX_PRIOR_TXS=5

# If the wallet has 1..N prior txs, fetch them and reject the wallet if any
# touched the pump.fun program before (bought or launched previously).
CHECK_PUMPFUN_HISTORY=true

# --- Noise control ----------------------------------------------------
# Only alert if the dev's initial buy is at least this many SOL (0 = off).
# Start around 0.5-1.0 or your Telegram will be a firehose.
MIN_DEV_BUY_SOL=0.5

# Which launchpad pools to watch (PumpPortal streams more than just pump).
# e.g. POOLS=pump,bonk
POOLS=pump

# --- Plumbing (defaults are fine) --------------------------------------
RPC_CONCURRENCY=4
WORKERS=4
ALERT_MIN_INTERVAL=3.0
ALERT_QUEUE_SIZE=25
EVENT_QUEUE_SIZE=300
DB_PATH=fresh_bot.db
LOG_LEVEL=INFO
